# Единые переводы строк: в репозитории всегда LF.
#
# Иначе Windows-чекаут превращает LF в CRLF, и файлы, которые исполняются
# в CI (shell-скрипты, versioning.py), ломаются на "\r: command not found".
* text=auto eol=lf

# Кодировка исходников — UTF-8 без BOM. Кириллица в комментариях, сид-данных и
# текстах интерфейса: если файл уедет в CP1251, в БД осядет «РљР°СЂСЊРµСЂР°»
# (это уже случалось — 0005_org_contacts.sql залилась мимо UTF-8).
*.sql   text working-tree-encoding=UTF-8
*.ts    text working-tree-encoding=UTF-8
*.dart  text working-tree-encoding=UTF-8
*.md    text working-tree-encoding=UTF-8
*.json  text working-tree-encoding=UTF-8
*.js    text working-tree-encoding=UTF-8
*.ps1   text eol=crlf working-tree-encoding=UTF-8

# Бинарные файлы — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary

# Эти форматы на Windows traditionally CRLF, но в CI не исполняются
*.bat text eol=crlf

# Gradle wrapper должен остаться исполняемым
gradlew text eol=lf
*.sh text eol=lf

# Lock-файлы не показывать в diff
pubspec.lock linguist-generated=true
package-lock.json linguist-generated=true